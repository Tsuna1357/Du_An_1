.root {
    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;

    overflow: hidden;
}

.background {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-color: rgb(17, 16, 14);
}


/* =========================
   LOGIN / REGISTER PANEL
   ========================= */

.login-panel {
    width: 900px;
    height: 760px;

    padding-left: 110px;
    padding-right: 110px;
    padding-top: 55px;
    padding-bottom: 45px;

    background-color: rgb(31, 29, 25);

    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;

    border-left-color: rgb(75, 69, 59);
    border-right-color: rgb(75, 69, 59);
    border-top-color: rgb(75, 69, 59);
    border-bottom-color: rgb(75, 69, 59);

    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;

    align-items: stretch;
}


/* =========================
   TITLE
   ========================= */

.game-title {
    color: rgb(205, 194, 166);

    font-size: 48px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    margin-bottom: 8px;
}

.form-title {
    color: rgb(155, 146, 125);

    font-size: 27px;

    -unity-text-align: middle-center;

    margin-bottom: 38px;
}


/* =========================
   LABEL
   ========================= */

.field-label {
    color: rgb(190, 181, 158);

    font-size: 17px;

    margin-bottom: 7px;
}


/* =========================
   INPUT
   ========================= */

.input-field {
    height: 65px;

    margin-bottom: 22px;

    background-color: rgb(255, 255, 255);

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgb(70, 65, 56);
    border-right-color: rgb(70, 65, 56);
    border-top-color: rgb(70, 65, 56);
    border-bottom-color: rgb(70, 65, 56);

    color: rgb(65, 45, 30);
    -unity-text-color: rgb(65, 45, 30);

    font-size: 21px;
}
.input-field:focus {
    color: rgb(55, 38, 25);
    -unity-text-color: rgb(55, 38, 25);

    border-left-color: rgb(175, 160, 125);
    border-right-color: rgb(175, 160, 125);
    border-top-color: rgb(175, 160, 125);
    border-bottom-color: rgb(175, 160, 125);
}

/* =========================
   LOGIN / REGISTER BUTTON
   ========================= */

.main-button {
    height: 68px;

    margin-top: 10px;

    background-color: rgb(82, 71, 55);

    color: rgb(240, 233, 214);

    font-size: 22px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.main-button:hover {
    background-color: rgb(108, 92, 68);
}

.main-button:active {
    background-color: rgb(60, 52, 42);
}


/* =========================
   REGISTER / BACK BUTTON
   ========================= */

.link-button {
    height: 45px;

    margin-top: 12px;

    background-color: rgba(0, 0, 0, 0);

    color: rgb(175, 164, 140);

    font-size: 17px;

    -unity-text-align: middle-center;

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.link-button:hover {
    color: rgb(215, 204, 178);
}

.link-button:active {
    color: rgb(135, 124, 104);
}


/* =========================
   MESSAGE
   ========================= */

.message {
    min-height: 30px;

    margin-top: 8px;

    color: rgb(195, 183, 151);

    font-size: 16px;

    -unity-text-align: middle-center;
}


/* =========================
   REGISTER PANEL
   ========================= */

.register-panel {
    display: none;
}